# Inject into the Node service only; never load backend secrets into Vite.
NODE_ENV=production
DEPLOYMENT_MODE=sites
AI_PORT=8787
BIND_HOST=127.0.0.1
ALLOWED_HOSTS=127.0.0.1:8787,localhost:8787
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Exact HTTPS frontend origin, no trailing slash; comma-separated only if required.
AI_ALLOWED_ORIGINS=
SESSION_SECRET=
# The same random base64url token (43-128 chars) in Node and Sites Secrets.
APP_GATEWAY_TOKEN=
DATABASE_URL=
PG_SSL_MODE=verify-full
# Optional private CA file; certificate verification must remain enabled.
PG_SSL_CA_FILE=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Leave empty to use path-style for custom endpoints, virtual-host style for AWS.
S3_FORCE_PATH_STYLE=
# Production AI remains disabled until ownership, evidence and quota acceptance.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=30000
