# Copy to .env only if it does not exist. Never commit credentials.
# Local development defaults to SQLite and private files in .paperflow-data.
PAPERFLOW_DATA_DIR=.paperflow-data
# Set a stable random secret of at least 32 characters; required in production.
SESSION_SECRET=
# Set DATABASE_URL for PostgreSQL. Run npm run db:migrate before starting it.
DATABASE_URL=
# S3-compatible private bucket; all four settings are required together.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional S3-compatible endpoint; HTTPS except loopback HTTP for local development.
S3_ENDPOINT=

# OpenAI-compatible Chat Completions base URL; do not include /chat/completions.
# Remote providers require HTTPS. Plain HTTP is allowed only on loopback for local testing.
AI_BASE_URL=
# Use the model name and API key supplied by your trusted relay.
AI_MODEL=
AI_API_KEY=
# Optional: request timeout in milliseconds and local AI server port.
AI_TIMEOUT_MS=30000
AI_PORT=8787
# Optional: comma-separated browser origins when using non-default front-end ports.
# AI_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
